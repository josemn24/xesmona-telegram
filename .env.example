# Copy this file to .env (in the repo root) and fill in the values. Never commit .env to git.
# Production variables are set in Railway: see docs/deploy.md.

# --- Server -----------------------------------------------------------------
PORT=3000
# polling (local development) | webhook (staging/production)
BOT_MODE=polling
# Public HTTPS URL of the server; required with BOT_MODE=webhook
PUBLIC_URL=

# --- Supabase (required to run bots; `supabase status` prints the local values) ---
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_SERVICE_ROLE_KEY=
# Mini App games (Realtime, ADR 0009). Without both, /four is unavailable.
# Publishable key: `supabase status` (Publishable). Public, sent to the Mini App.
SUPABASE_PUBLISHABLE_KEY=
# JWT secret that signs players' Realtime tokens: `supabase status -o env` (JWT_SECRET); in the
# cloud, the project's legacy JWT secret. Server only.
SUPABASE_JWT_SECRET=

# --- Bot: games (BOT_<ID>_ prefix) ------------------------------------------
# Token from @BotFather. Use a different bot per environment (dev/staging/prod).
BOT_GAMES_TOKEN=
# 16-256 characters [A-Za-z0-9_-]; required with BOT_MODE=webhook
BOT_GAMES_WEBHOOK_SECRET=
# Direct link of the Mini App created in @BotFather (/newapp), e.g. https://t.me/<bot>/<app>
BOT_GAMES_MINIAPP_URL=
