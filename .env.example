# Copia este archivo a .env (en la raíz) y rellena los valores. Nunca subas .env a git.

# --- Servidor ---------------------------------------------------------------
PORT=3000
# polling (desarrollo local) | webhook (staging/producción)
BOT_MODE=polling
# URL pública HTTPS del servidor; obligatoria con BOT_MODE=webhook
PUBLIC_URL=

# --- Supabase (pnpm db:start muestra los valores locales) -------------------
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_SERVICE_ROLE_KEY=

# --- Bot: games (prefijo BOT_<ID>_) -----------------------------------------
# Token de @BotFather. Usa un bot distinto por entorno (dev/staging/prod).
BOT_GAMES_TOKEN=
# 16-256 caracteres [A-Za-z0-9_-]; obligatorio con BOT_MODE=webhook
BOT_GAMES_WEBHOOK_SECRET=
# Direct link de la Mini App creada en @BotFather (/newapp), p. ej. https://t.me/<bot>/<app>
BOT_GAMES_MINIAPP_URL=
